table heart_disease_clean
	lineageTag: 94f363d4-2917-4a74-a5c1-f2847148195d

	measure 'Total Patients' = COUNTROWS ( heart_disease_clean )
		formatString: 0
		displayFolder: 1 Core KPIs
		lineageTag: 82e67d3e-f1fd-47f3-bf32-10d3dd9b0b53

	measure 'Disease Cases' = SUM ( heart_disease_clean[heart_disease] )
		formatString: 0
		displayFolder: 1 Core KPIs
		lineageTag: 49c2723b-0909-4a21-8520-817099ac1895

	measure 'No Disease Cases' = [Total Patients] - [Disease Cases]
		formatString: 0
		displayFolder: 1 Core KPIs
		lineageTag: fa28956b-ff42-4547-8c33-1633f0d04b35

	measure 'Disease Rate' = DIVIDE ( [Disease Cases], [Total Patients] )
		formatString: 0%
		displayFolder: 1 Core KPIs
		lineageTag: 737b71da-7ff6-4568-98c9-4d5f64abe078

	measure 'Overall Disease Rate' = CALCULATE ( [Disease Rate], REMOVEFILTERS ( heart_disease_clean ) )
		formatString: 0%
		displayFolder: 1 Core KPIs
		lineageTag: a7067e8f-1a68-47a9-b3da-e817b7b6290a

	measure 'Rate vs Overall (pts)' = ( [Disease Rate] - [Overall Disease Rate] ) * 100
		formatString: 0.0
		displayFolder: 1 Core KPIs
		lineageTag: f4e8bb3a-ec1d-4667-93d1-6288e6ec843d

	measure 'Median Age' = MEDIAN ( heart_disease_clean[age] )
		formatString: 0.0
		displayFolder: 2 Patient profile
		lineageTag: aa30798b-5a81-4ce8-86ab-31db58212117

	measure '% Male' = DIVIDE ( CALCULATE ( [Total Patients], heart_disease_clean[sex] = "Male" ), [Total Patients] )
		formatString: 0%
		displayFolder: 2 Patient profile
		lineageTag: a3380a57-7600-4ce2-afc7-c84d847e60fa

	measure '% Female' = 1 - [% Male]
		formatString: 0%
		displayFolder: 2 Patient profile
		lineageTag: 9a425257-c718-4921-8926-da8f5f262ccd

	measure 'Avg Max Heart Rate' = AVERAGE ( heart_disease_clean[max_heart_rate] )
		formatString: 0
		displayFolder: 2 Patient profile
		lineageTag: 5a725439-2850-405f-8d2d-2985d285d409

	measure 'Avg Cholesterol' = AVERAGE ( heart_disease_clean[cholesterol] )
		formatString: 0
		displayFolder: 2 Patient profile
		lineageTag: e61ef638-386c-4957-8557-5b4107b7ced8

	measure 'Avg Resting BP' = AVERAGE ( heart_disease_clean[resting_bp] )
		formatString: 0
		displayFolder: 2 Patient profile
		lineageTag: a25b61f1-b53a-42e3-93a0-9132ccc5be5a

	measure 'High Risk Patients' = CALCULATE ( [Total Patients], heart_disease_clean[risk_tier] = "High" )
		formatString: 0
		displayFolder: 3 Risk tiers
		lineageTag: b49c7ba6-0262-4ebc-a300-9318e0071b8d

	measure 'High Risk Share of Patients' = DIVIDE ( [High Risk Patients], [Total Patients] )
		formatString: 0%
		displayFolder: 3 Risk tiers
		lineageTag: 869cb36d-9f7c-4be9-b2f2-5b301c8a5481

	measure 'High Risk Share of Cases' = DIVIDE ( CALCULATE ( [Disease Cases], heart_disease_clean[risk_tier] = "High" ), [Disease Cases] )
		formatString: 0%
		displayFolder: 3 Risk tiers
		lineageTag: 6476a8cc-f5ea-4ac6-afe3-a9af5cd60d87

	measure 'Share of All Cases' = DIVIDE ( [Disease Cases], CALCULATE ( [Disease Cases], REMOVEFILTERS ( heart_disease_clean[risk_tier], heart_disease_clean[risk_tier_order] ) ) )
		formatString: 0%
		displayFolder: 3 Risk tiers
		lineageTag: c6fc6a5b-644d-424b-82f4-1f4331931c45

	measure 'Avg Warning Signs' = AVERAGE ( heart_disease_clean[warning_signs] )
		formatString: 0.0
		displayFolder: 3 Risk tiers
		lineageTag: e27b8e17-6a8b-4d7f-aa37-78d9d2e9e2ee

	measure 'Rate Label' = FORMAT ( [Disease Rate], "0%" ) & "  (n=" & [Total Patients] & ")"
		displayFolder: 4 Labels
		lineageTag: f774eb29-5d15-4efb-9390-47e68b87049a

	measure 'Selection Title' =
			VAR _sex = IF ( ISFILTERED ( heart_disease_clean[sex] ), SELECTEDVALUE ( heart_disease_clean[sex], "Mixed sexes" ), "All patients" )
			VAR _age = IF ( ISFILTERED ( heart_disease_clean[age_group] ), " · Age " & SELECTEDVALUE ( heart_disease_clean[age_group], "several groups" ), "" )
			RETURN _sex & _age & " · " & FORMAT ( [Total Patients], "0" ) & " patients"
		displayFolder: 4 Labels
		lineageTag: faf81952-0c7c-4c5d-92f1-7c3ca0ec2f40

	measure 'Unknown Vessel Results' = CALCULATE ( [Total Patients], heart_disease_clean[vessels_label] = "Unknown" )
		formatString: 0
		displayFolder: 5 Data quality
		lineageTag: f757257a-af69-4344-ad4b-0644edf72149

	measure 'Unknown Thallium Results' = CALCULATE ( [Total Patients], heart_disease_clean[thallium_result] = "Unknown" )
		formatString: 0
		displayFolder: 5 Data quality
		lineageTag: ecaeec66-f66e-4086-a5d7-ad5a3726dea0

	measure 'Issues Found' = COUNTROWS ( data_quality_log )
		formatString: 0
		displayFolder: 5 Data quality
		lineageTag: 326578a6-500c-4715-a732-abddc58002d1

