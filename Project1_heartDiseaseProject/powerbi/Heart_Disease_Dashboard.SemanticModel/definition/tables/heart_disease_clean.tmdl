	partition heart_disease_clean = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "heart_disease_clean.csv"), [Delimiter = ",", Columns = 41, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"patient_id", type text}, {"age", Int64.Type}, {"age_group", type text}, {"sex", type text}, {"chest_pain_type", type text}, {"resting_bp", Int64.Type}, {"bp_category", type text}, {"cholesterol", Int64.Type}, {"cholesterol_category", type text}, {"high_fasting_sugar", type text}, {"resting_ecg", type text}, {"max_heart_rate", Int64.Type}, {"max_hr_band", type text}, {"exercise_angina", type text}, {"st_depression", type number}, {"st_depression_band", type text}, {"st_slope", type text}, {"vessels_blocked", Int64.Type}, {"vessels_label", type text}, {"thallium_result", type text}, {"sign_silent_chest_pain", Int64.Type}, {"sign_exercise_angina", Int64.Type}, {"sign_st_depression", Int64.Type}, {"sign_low_max_hr", Int64.Type}, {"sign_vessels_narrowed", Int64.Type}, {"sign_thallium_defect", Int64.Type}, {"warning_signs", Int64.Type}, {"risk_tier", type text}, {"heart_disease", Int64.Type}, {"diagnosis", type text}, {"original_target", Int64.Type}, {"age_group_order", Int64.Type}, {"bp_category_order", Int64.Type}, {"cholesterol_category_order", Int64.Type}, {"max_hr_band_order", Int64.Type}, {"st_depression_band_order", Int64.Type}, {"chest_pain_type_order", Int64.Type}, {"resting_ecg_order", Int64.Type}, {"st_slope_order", Int64.Type}, {"thallium_result_order", Int64.Type}, {"risk_tier_order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

