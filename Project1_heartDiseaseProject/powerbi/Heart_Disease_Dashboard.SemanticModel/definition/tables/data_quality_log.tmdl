	partition data_quality_log = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "data_quality_log.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"issue", type text}, {"rows_affected", Int64.Type}, {"action", type text}, {"note", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

