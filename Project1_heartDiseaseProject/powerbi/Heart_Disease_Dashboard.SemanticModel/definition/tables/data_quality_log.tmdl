table data_quality_log
	lineageTag: ec03ba27-2e69-4163-9c44-6761e96674ee

	column issue
		dataType: string
		lineageTag: b32cae71-fcc6-443f-9deb-3e6965192134
		summarizeBy: none
		sourceColumn: issue

		annotation SummarizationSetBy = Automatic

	column rows_affected
		dataType: int64
		formatString: 0
		lineageTag: 2286552b-4225-4720-82b4-37e170fefd8c
		summarizeBy: sum
